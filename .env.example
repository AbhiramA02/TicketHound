# Copy to .env and adjust. Never commit real secrets.

# --- Shared / local ---
DEMO_MODE=true
PROVIDER_DEMO_ENABLED=true
PROVIDER_TICKETMASTER_ENABLED=false

# Postgres (matches compose.yaml defaults)
POSTGRES_USER=tickethound
POSTGRES_PASSWORD=tickethound
POSTGRES_DB=tickethound
DATABASE_URL=postgresql+psycopg://tickethound:tickethound@localhost:5432/tickethound

# API
CORS_ORIGINS=http://localhost:43123,http://127.0.0.1:43123
LOG_LEVEL=INFO

# Phase 1+ — leave empty until you have a key; never commit the value.
# Live search: DEMO_MODE=false, PROVIDER_TICKETMASTER_ENABLED=true, and a key.
# TICKETMASTER_MIN_INTERVAL_SECONDS defaults to 0.5 (2 requests/second).
TICKETMASTER_API_KEY=
TICKETMASTER_MIN_INTERVAL_SECONDS=0.5

# Web
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
